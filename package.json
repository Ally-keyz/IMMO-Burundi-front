{
  "name": "immo-burundi-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IMMO BURUNDI — Web. Real estate marketplace & brokerage frontend.",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/seo-build.mjs",
    "build:app": "tsc -b && vite build",
    "seo": "node scripts/seo-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:shared-types": "node scripts/check-shared-types.mjs"
  },
  "dependencies": {
    "@immo/shared-types": "workspace:*",
    "axios": "^1.7.9",
    "framer-motion": "^11.12.0",
    "leaflet": "^1.9.4",
    "lottie-react": "^3.1.2",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
